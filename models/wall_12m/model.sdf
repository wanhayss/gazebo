<?xml version="1.0"?>
<!--
  wall: box, 2.5 m tall, 8.5 m long (along X), 0.1 m thick (along Y).
  Length and thickness are estimates from the field layout figure.
  To change the length, edit the first number in both <size> tags.
  The model origin is at ground level, at the centre of the wall.
-->
<sdf version="1.9">
  <model name="wall_12m">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry><box><size>12 0.1 2.5</size></box></geometry>
        <material>
          <ambient>0.5 0.1 0.5 1</ambient>
          <diffuse>0.6 0.15 0.6 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 1.25 0 0 0</pose>
        <geometry><box><size>8.5 0.1 2.5</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
