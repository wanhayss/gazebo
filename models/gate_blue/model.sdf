<?xml version="1.0"?>
<!--
  gate_blue: Standard gate (A, B and C2), Gazebo Harmonic / SDF 1.9
    Total height 2.375 m, opening 1.5 x 1.5 m, opening bottom at 0.675 m,
    frame border 0.2 m (outer 1.9 x 1.9 m), frame depth 0.05 m (assumed).
  Gate plane is Y-Z (faces along X).
-->
<sdf version="1.9">
  <model name="gate_blue">
    <static>true</static>

    <link name="frame">
      <visual name="bottom_bar">
        <pose>0 0 0.575 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
        <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material>
      </visual>
      <collision name="bottom_bar_col">
        <pose>0 0 0.575 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
      </collision>

      <visual name="top_bar">
        <pose>0 0 2.275 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
        <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material>
      </visual>
      <collision name="top_bar_col">
        <pose>0 0 2.275 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
      </collision>

      <visual name="left_bar">
        <pose>0 0.85 1.425 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.5</size></box></geometry>
        <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material>
      </visual>
      <collision name="left_bar_col">
        <pose>0 0.85 1.425 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.5</size></box></geometry>
      </collision>

      <visual name="right_bar">
        <pose>0 -0.85 1.425 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.5</size></box></geometry>
        <material><ambient>0.1 0.2 0.7 1</ambient><diffuse>0.15 0.25 0.8 1</diffuse></material>
      </visual>
      <collision name="right_bar_col">
        <pose>0 -0.85 1.425 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.5</size></box></geometry>
      </collision>
    </link>

    <link name="stand">
      <visual name="post_left">
        <pose>0 0.85 0.2375 0 0 0</pose>
        <geometry><box><size>0.05 0.1 0.475</size></box></geometry>
        <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.35 1</diffuse></material>
      </visual>
      <collision name="post_left_col">
        <pose>0 0.85 0.2375 0 0 0</pose>
        <geometry><box><size>0.05 0.1 0.475</size></box></geometry>
      </collision>

      <visual name="post_right">
        <pose>0 -0.85 0.2375 0 0 0</pose>
        <geometry><box><size>0.05 0.1 0.475</size></box></geometry>
        <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.35 1</diffuse></material>
      </visual>
      <collision name="post_right_col">
        <pose>0 -0.85 0.2375 0 0 0</pose>
        <geometry><box><size>0.05 0.1 0.475</size></box></geometry>
      </collision>

      <!-- Triangular feet (extrusion runs toward -Y, so pose Y = post Y + 0.05) -->
      <visual name="foot_left">
        <pose>0 0.9 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>0.025 0</point><point>0.5 0</point><point>0.025 0.4</point>
            <height>0.1</height>
          </polyline>
        </geometry>
        <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.35 1</diffuse></material>
      </visual>
      <collision name="foot_left_col">
        <pose>0 0.9 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>0.025 0</point><point>0.5 0</point><point>0.025 0.4</point>
            <height>0.1</height>
          </polyline>
        </geometry>
      </collision>

      <visual name="foot_right">
        <pose>0 -0.8 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>0.025 0</point><point>0.5 0</point><point>0.025 0.4</point>
            <height>0.1</height>
          </polyline>
        </geometry>
        <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.35 1</diffuse></material>
      </visual>
      <collision name="foot_right_col">
        <pose>0 -0.8 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>0.025 0</point><point>0.5 0</point><point>0.025 0.4</point>
            <height>0.1</height>
          </polyline>
        </geometry>
      </collision>
    </link>

    <joint name="frame_to_stand" type="fixed">
      <parent>stand</parent>
      <child>frame</child>
    </joint>
  </model>
</sdf>
