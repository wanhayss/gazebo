<?xml version="1.0"?>
<!--
  gate_yellow: Short gate (C1), Gazebo Harmonic / SDF 1.9
    Total height 1.4 m, opening 1.5 m wide x 1.0 m tall, frame border 0.2 m
    (outer frame 1.9 m wide x 1.4 m tall), frame depth 0.05 m (assumed).
    The frame sits on the ground; triangular wooden feet are attached
    to the outer sides at the bottom.
  Gate plane is Y-Z (faces along X).
-->
<sdf version="1.9">
  <model name="gate_yellow">
    <static>true</static>

    <link name="frame">
      <!-- Bottom bar: z 0 to 0.2 -->
      <visual name="bottom_bar">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
        <material><ambient>0.9 0.65 0.05 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
      </visual>
      <collision name="bottom_bar_col">
        <pose>0 0 0.1 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
      </collision>

      <!-- Top bar: z 1.2 to 1.4 -->
      <visual name="top_bar">
        <pose>0 0 1.3 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
        <material><ambient>0.9 0.65 0.05 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
      </visual>
      <collision name="top_bar_col">
        <pose>0 0 1.3 0 0 0</pose>
        <geometry><box><size>0.05 1.9 0.2</size></box></geometry>
      </collision>

      <!-- Left bar: y 0.75 to 0.95, z 0.2 to 1.2 -->
      <visual name="left_bar">
        <pose>0 0.85 0.7 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.0</size></box></geometry>
        <material><ambient>0.9 0.65 0.05 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
      </visual>
      <collision name="left_bar_col">
        <pose>0 0.85 0.7 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.0</size></box></geometry>
      </collision>

      <!-- Right bar: y -0.95 to -0.75, z 0.2 to 1.2 -->
      <visual name="right_bar">
        <pose>0 -0.85 0.7 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.0</size></box></geometry>
        <material><ambient>0.9 0.65 0.05 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
      </visual>
      <collision name="right_bar_col">
        <pose>0 -0.85 0.7 0 0 0</pose>
        <geometry><box><size>0.05 0.2 1.0</size></box></geometry>
      </collision>
    </link>

    <link name="stand">
      <!--
        Triangular feet on the outer sides of the frame, polyline rolled 90 deg
        so the triangle lies in the X-Z plane. Extrusion runs toward -Y.
        Foot width 0.05 m: left spans y 0.95..1.0, right spans y -1.0..-0.95.
        Triangle: 0.5 m base on the ground, 0.4 m tall against the frame.
      -->
      <visual name="foot_left">
        <pose>0 1.0 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>-0.025 0</point><point>0.5 0</point><point>-0.025 0.4</point>
            <height>0.05</height>
          </polyline>
        </geometry>
        <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.35 1</diffuse></material>
      </visual>
      <collision name="foot_left_col">
        <pose>0 1.0 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>-0.025 0</point><point>0.5 0</point><point>-0.025 0.4</point>
            <height>0.05</height>
          </polyline>
        </geometry>
      </collision>

      <visual name="foot_right">
        <pose>0 -0.95 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>-0.025 0</point><point>0.5 0</point><point>-0.025 0.4</point>
            <height>0.05</height>
          </polyline>
        </geometry>
        <material><ambient>0.75 0.55 0.3 1</ambient><diffuse>0.8 0.6 0.35 1</diffuse></material>
      </visual>
      <collision name="foot_right_col">
        <pose>0 -0.95 0 1.5708 0 0</pose>
        <geometry>
          <polyline>
            <point>-0.025 0</point><point>0.5 0</point><point>-0.025 0.4</point>
            <height>0.05</height>
          </polyline>
        </geometry>
      </collision>
    </link>

    <joint name="frame_to_stand" type="fixed">
      <parent>stand</parent>
      <child>frame</child>
    </joint>
  </model>
</sdf>
